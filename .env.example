# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=your_google_analytics_id

# API endpoints (if needed)
# NEXT_PUBLIC_API_URL=https://api.example.com
